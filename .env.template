# Gradebook configuration. Copy to .env and edit:  cp .env.template .env
# .env is git-ignored; never commit real passwords.

# ── Where student data lives ─────────────────────────────────────────────────
# memory      (default) Student data is only held in memory while a teacher is
#             signed in. Teachers save their work as a workbook (.xlsx) and open
#             it next time. Nothing about students is written to /data.
# persistent  Everything is stored in /data/gradebook.db (with daily backups).
STORAGE=memory
# memory: the most one teacher's open work may use, in MB.
# WORKSPACE_MAX_MB=256

# ── How teachers sign in ─────────────────────────────────────────────────────
# password (default) Accounts with passwords (and optional 2-step codes),
#          created by an admin.
# oidc     Board single sign-on (Microsoft Entra ID, Google Workspace, …).
#          Accounts are created the first time a teacher signs in.
AUTH=password

# For AUTH=oidc. Register a web app with the provider, redirect URI:
#   ${PUBLIC_URL}/login/oidc/callback
# Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
# Google issuer:   https://accounts.google.com
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# PUBLIC_URL=https://gradebook.example-board.ca
# Button text: "Sign in with …"
# OIDC_DISPLAY_NAME=Example District School Board
# Only these email domains may sign in (comma-separated; strongly recommended).
# OIDC_ALLOWED_DOMAINS=example-board.ca
# These people are admins (comma-separated emails).
# OIDC_ADMIN_EMAILS=it.lead@example-board.ca
# Also allow password accounts (e.g. a break-glass admin). Default false.
# ALLOW_PASSWORD_LOGIN=false

# ── Retention and audit (board deployments) ─────────────────────────────────
# persistent storage: delete terms this many days after they're archived.
# RETENTION_DAYS=400
# Keep the audit log (sign-ins, saves, report downloads) this many days.
# AUDIT_KEEP_DAYS=365

# ── First admin account ──────────────────────────────────────────────────────
# Only used when the database has no accounts yet. Required on first start
# with AUTH=password (unless accounts are imported from the old Python
# version's users.db). With AUTH=oidc, use OIDC_ADMIN_EMAILS instead.
# The password needs 10+ characters with a letter and a number.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SCHOOL=

# ── Security ─────────────────────────────────────────────────────────────────
# Keep true when served over HTTPS (normal). Set false only for local http testing.
COOKIE_SECURE=true
# Set true when behind a reverse proxy (Traefik, nginx, Caddy…) so login rate
# limiting sees the real client address from X-Forwarded-For.
TRUST_PROXY=false
# Sign out after this many minutes without activity.
IDLE_TIMEOUT_MINUTES=120

# ── Backups ──────────────────────────────────────────────────────────────────
# A copy of the database (accounts, settings and, with persistent storage,
# all student data) is written to /data/backups daily. BACKUP_DIR=off disables.
# BACKUP_DIR=/data/backups
BACKUP_KEEP=14

# ── Time zone (report dates) ─────────────────────────────────────────────────
TZ=America/Toronto
